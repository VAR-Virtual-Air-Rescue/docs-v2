# Öffentliche Hub-URL (Browser-Weiterleitung zum Login)
HUB_URL=https://hub.virtualairrescue.com
# Interne Hub-URL für Server-zu-Server-Aufrufe (im Traefik-Netz z. B. http://hub:3000), leer = HUB_URL
HUB_INTERNAL_URL=
DOCS_URL=https://docs.virtualairrescue.com
# Client-Secret des Docs-Eintrags (id 5) in apps/hub/helper/authServices.ts und HUB_INTERNAL_API_SECRET aus der .env des Monorepos
DOCS_OAUTH_CLIENT_SECRET=
HUB_INTERNAL_API_SECRET=
# Signiert die Sitzungs-Cookies (min. 32 Zeichen): openssl rand -hex 32
DOCS_SESSION_SECRET=
# Nur lokal (npm run dev:gateway): Port des Gateways, muss zu DOCS_URL passen
# PORT=3006
# Quelle der Live-Daten für /api/airports, /api/stations, /api/hospitals (Standard: https://ops.virtualairrescue.com)
# OPS_API_URL=
